{
  "name": "medusa-storage-r2",
  "version": "0.1.0",
  "description": "Cloudflare R2 file storage for Medusa v2: credentials and bucket configured in the Admin (encrypted), public URL or custom domain, presigned uploads and downloads, connection test — by Haus Kayu",
  "author": "Haus Kayu <dev@hauskayu.com> (https://hauskayu.com)",
  "license": "MIT",
  "homepage": "https://github.com/haustex/fs-medusa-r2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haustex/fs-medusa-r2.git"
  },
  "bugs": {
    "url": "https://github.com/haustex/fs-medusa-r2/issues",
    "email": "dev@hauskayu.com"
  },
  "funding": "https://hauskayu.com",
  "files": [
    ".medusa/server",
    "!.medusa/server/**/__tests__",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-plugin-file",
    "medusa-file",
    "file-provider",
    "storage",
    "cloudflare",
    "cloudflare-r2",
    "r2",
    "s3-compatible",
    "uploads",
    "cdn"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "jest",
    "test:unit": "jest",
    "guard": "node scripts/guard.mjs",
    "db:generate": "node scripts/guard.mjs medusa plugin:db:generate",
    "prepublishOnly": "medusa plugin:build",
    "pack:check": "node scripts/check-pack.mjs",
    "test:e2e": "node integration-tests/e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/lib-storage": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/eslint-plugin": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/test-utils": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.19.0",
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/icons": "^2.19.0",
    "@medusajs/js-sdk": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/test-utils": "^2.19.0",
    "@medusajs/ui": "^4.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@10.9.9"
}
